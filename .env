# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=workplace_relations
MONGO_COLLECTION=records
MONGO_PROCESSED_COLLECTION=processed_records

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=adminadmin
MINIO_BUCKET=landing-zone
MINIO_PROCESSED_BUCKET=processed

# Scrapy Configuration
ALLOWED_DOMAINS=["workplacerelations.ie"]
SCRAPY_CONCURRENT_REQUESTS=10
SCRAPY_DOWNLOAD_DELAY=0.5
SCRAPY_RETRY_TIMES=3
SCRAPY_AUTOTHROTTLE_TARGET=1.0
SCRAPY_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36